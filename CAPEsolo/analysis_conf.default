[analysis]
id = 2
ip = 127.0.0.1
port = 9999
category = file
terminate_processes = False
enable_trim = 1
file_type =
exports =
amsi = True
browser = True
digisig = True
disguise = True
evtx = False
; Imports the module; JsConsole then starts only for JS runtimes (package = nodejs, bun, deno)
js_console = True
procmon = False
recentfiles = False
; TLS secrets for decrypting a capture taken outside the guest, read by the Network tab.
; tlsdump injects capemon into lsass for Schannel; sslkeylogfile covers anything honouring
; the SSLKEYLOGFILE variable. The analyzer only imports an auxiliary module whose name it
; finds here, so sslkeylogfile never loaded while this key was absent.
sslkeylogfile = True
tlsdump = True
usage = False
file_pickup = True
permissions = False
pre_script = False
during_script = False
filecollector = True
windows_static_route = False
; Largest file the analyzer will send to the ResultServer. Bigger files are trimmed when
; enable_trim is set and they are PE images, otherwise skipped with a warning.
upload_max_size = 300000000
; Set to 1 to ignore upload_max_size and send everything.
;do_upload_max_size = 0
syscall = 1